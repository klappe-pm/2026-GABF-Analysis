{
  "schema-version": 1,
  "status": "DRAFT",
  "note": "The GABF Analysis design manifest, read by the agent-graph design control plane engine. Token nodes are synthesized from docs/design/tokens.json, which is published from site/assets/styles.css. Every other design artifact is a node with a kind, its content, and the ids it consumes; reversing the consumes edges answers what a change reaches. Copy and error nodes carry the site's reader facing text verbatim as the built pages render it. Each screen's state says how the review server reaches it: the route (from its surface unless the screen names one), the URL hash, how the data is served (site, site-slow holds the data files, site-fail answers them with an error), an optional drive step after load, and the frame width.",
  "nodes": {
    "style:h1": { "kind": "style", "content": "system-ui 1.7rem, line height 1.2, letter spacing minus 0.01em", "consumes": ["token:text-primary"] },
    "style:h2": { "kind": "style", "content": "system-ui 1.25rem", "consumes": ["token:text-primary"] },
    "style:body": { "kind": "style", "content": "system-ui 16px, line height 1.5", "consumes": ["token:text-primary", "token:page"] },
    "style:small": { "kind": "style", "content": "0.88rem", "consumes": ["token:text-secondary"] },
    "style:lede": { "kind": "style", "content": "secondary text, at most 62ch", "consumes": ["token:text-secondary"] },
    "style:pill": { "kind": "style", "content": "0.8rem in a rounded outline", "consumes": ["token:border", "token:surface-1", "token:text-secondary"] },

    "component:header": { "kind": "component", "content": "Site header: the GABF Analysis brand, the site navigation (a Menu button at phone width), the Filters button, and the theme toggle", "consumes": ["token:surface-1", "token:border", "token:text-primary", "token:text-secondary", "token:page", "style:body"] },
    "component:sidebar": { "kind": "component", "content": "Not drawn on this site. The shared surface synthesis in the engine gives every surface a sidebar and a header; GABF Analysis pages have no sidebar, so this node stands for that absence and consumes only the page background.", "consumes": ["token:page"] },
    "component:footer": { "kind": "component", "content": "Site footer: sources, the estimates note, and the link to the source and data", "consumes": ["token:border", "token:text-secondary", "style:small"] },
    "component:filter-trigger": { "kind": "component", "content": "The Filters button in the header, with the count of active filters; shortcut f", "consumes": ["token:card", "token:border", "token:text-secondary", "token:focus", "style:body"] },
    "component:filter-chips": { "kind": "component", "content": "Chips under the header naming each active filter, each removable, with Clear all", "consumes": ["token:surface-1", "token:border", "token:text-secondary", "token:link", "style:small"] },
    "component:filter-panel": { "kind": "component", "content": "The Filter medals dialog: search, the When, What, Where, and Who groups with counts, Include partial years, the match total, Reset, and Show results", "consumes": ["token:card", "token:border", "token:control-border", "token:text-primary", "token:text-muted", "style:body", "style:small"] },
    "component:empty-state": { "kind": "component", "content": "The empty state: what matched nothing, a button per active filter to remove it, and Include partial years when that would help", "consumes": ["token:card", "token:border", "style:body", "copy:empty.title"] },
    "component:notice": { "kind": "component", "content": "A notice with an amber left rule: the partial years notice, and the data error message", "consumes": ["token:series-4", "token:card", "token:text-secondary", "style:small"] },
    "component:stat-tiles": { "kind": "component", "content": "Stat tiles: a label, a value, and a note, estimates marked (E)", "consumes": ["token:card", "token:border", "token:text-muted", "style:small"] },
    "component:chart-figure": { "kind": "component", "content": "An ECharts figure with a title, a subtitle, a note, and a Table view", "consumes": ["token:grid", "token:axis", "token:series-1", "token:series-2", "token:series-3", "token:series-4", "token:series-5", "token:series-6", "token:series-7", "token:series-8", "token:text-secondary", "style:small"] },
    "component:data-table": { "kind": "component", "content": "A ruled table, sortable where marked, scrolling inside its own frame on a phone", "consumes": ["token:border", "token:surface-1", "token:text-secondary", "style:small"] },
    "component:medal-marks": { "kind": "component", "content": "Gold, silver, and bronze dots and the one line G-S-B count", "consumes": ["token:medal-gold", "token:medal-silver", "token:medal-bronze"] },
    "component:us-map": { "kind": "component", "content": "The US state map of medals; a click picks the state as a filter", "consumes": ["token:series-1", "token:mark-muted", "token:border"] },
    "component:dashboard-nav": { "kind": "component", "content": "Links between the dashboards", "consumes": ["token:link", "token:text-secondary"] },
    "component:pills": { "kind": "component", "content": "Pills for brewery type, place, founding, ownership, distribution, and streak", "consumes": ["style:pill", "token:good", "token:warn"] },
    "component:est-mark": { "kind": "component", "content": "The (E) button beside an estimated figure", "consumes": ["token:link", "token:focus"] },
    "component:est-popover": { "kind": "component", "content": "The estimate note: the figure, how it was estimated, the inputs, Estimate, not reported, and a link to the method", "consumes": ["token:card", "token:control-border", "token:text-primary", "token:focus", "copy:estimate.foot"] },
    "component:spec-card": { "kind": "component", "content": "A winning beer's spec card: style, ABV, IBU, hops, malts, yeast, adjuncts, each with its source", "consumes": ["token:card", "token:border", "style:small"] },
    "component:explorer-app": { "kind": "component", "content": "The explorer, a single page built by scripts/build-explorer.mjs with its own stylesheet; it does not load the site stylesheet or its tokens", "consumes": ["copy:explorer.title"] },

    "copy:overview.title": { "kind": "copy", "content": "Great American Beer Festival results dashboards", "consumes": [] },
    "copy:overview.lede": { "kind": "copy", "content": "Which states, styles, and breweries keep winning at the Great American Beer Festival. Start with the medal count by year, then see where the medals land on the map, which style families collect the most, and which breweries lead on points. The Filters button in the header narrows every page; click a bar, column, or state to focus it.", "consumes": [] },
    "copy:geography.title": { "kind": "copy", "content": "Geography", "consumes": [] },
    "copy:geography.lede": { "kind": "copy", "content": "Where the medals go: the US map, Census regions and divisions, Federal Reserve districts, medals per million residents and per $100 billion of real GDP using each medal year's population and GDP, and the demographic controls side by side. Click a state, region, or district to focus the other panels.", "consumes": [] },
    "copy:categories-dashboard.title": { "kind": "copy", "content": "Categories", "consumes": [] },
    "copy:categories-dashboard.lede": { "kind": "copy", "content": "Total entrants by category from the official category headers, with special categories (added ingredient, process, or catch all) marked, the classic versus special split by year, and category size against how many breweries medal.", "consumes": [] },
    "copy:breweries-dashboard.title": { "kind": "copy", "content": "Breweries", "consumes": [] },
    "copy:breweries-dashboard.lede": { "kind": "copy", "content": "Pick a brewery to see its medal trend (years before it opened and years not yet published are marked), its categories, and the locations credited. The global filter still scopes the stats and table.", "consumes": [] },
    "copy:economics.title": { "kind": "copy", "content": "Ownership and economics", "consumes": [] },
    "copy:economics.lede": { "kind": "copy", "content": "Who owns the medalists and what they are worth: ownership share, parent companies, and estimated revenue, ARR, gross margin, EBITDA, and distribution channel per brewery. Every financial figure is an estimate (E); the method is on the About page.", "consumes": [] },
    "copy:reports.title": { "kind": "copy", "content": "Reports", "consumes": [] },
    "copy:reports.lede": { "kind": "copy", "content": "Ready made views over the loaded results. Each follows the Filters selection in the header, carries a table view for every chart, and saves charts as PNG from the toolbox.", "consumes": [] },
    "copy:top-breweries.title": { "kind": "copy", "content": "Top breweries", "consumes": [] },
    "copy:top-breweries.lede": { "kind": "copy", "content": "Points weight gold 3, silver 2, bronze 1. Rankings use the medals in view; partial years join them only when you include them in Filters.", "consumes": [] },
    "copy:category.title": { "kind": "copy", "content": "American-Style India Pale Ale", "consumes": [] },
    "copy:brewery.title": { "kind": "copy", "content": "Green Cheek Beer Co.", "consumes": [] },
    "copy:winners.title": { "kind": "copy", "content": "2026 winners", "consumes": [] },
    "copy:winners.lede": { "kind": "copy", "content": "Every medal from the 2026 Great American Beer Festival with the beer's published specs: style, ABV, IBU, and named hops, malts, yeast, and adjuncts, each from the brewery or a cited source. Open a beer for its full research notes. Use Filters in the header to narrow by medal, style, place, or brewery, or search by beer, brewery, or hop.", "consumes": [] },
    "copy:beer.title": { "kind": "copy", "content": "Doom Sludge", "consumes": [] },
    "copy:first-time.title": { "kind": "copy", "content": "First time medalists in 2026", "consumes": [] },
    "copy:first-time.lede": { "kind": "copy", "content": "Breweries whose first GABF medal in the loaded results came in 2026, with each of their 2026 medals and the field each medal beat.", "consumes": [] },
    "copy:explorer.title": { "kind": "copy", "content": "What changed between years?", "consumes": [] },
    "copy:about.title": { "kind": "copy", "content": "About this site", "consumes": [] },
    "copy:about.lede": { "kind": "copy", "content": "An independent analysis of Great American Beer Festival competition results, built from public data and published with GitHub Pages. Charts are drawn with Apache ECharts; each one has a table view and saves as a PNG. The source code and data are public.", "consumes": [] },
    "copy:categories-index.title": { "kind": "copy", "content": "Categories", "consumes": [] },
    "copy:empty.title": { "kind": "copy", "content": "No medals match these filters.", "consumes": [] },
    "copy:empty.remove-hint": { "kind": "copy", "content": "Remove a filter to widen the view.", "consumes": [] },
    "copy:chip.partial": { "kind": "copy", "content": "Partial years included", "consumes": [] },
    "copy:partial.notice": { "kind": "copy", "content": "2018 and 2019 include only a sample of medals from secondary sources; complete official lists start in 2021. Read counts for those years as partial.", "consumes": [] },
    "copy:filters.title": { "kind": "copy", "content": "Filter medals", "consumes": [] },
    "copy:filters.loading": { "kind": "copy", "content": "Loading the medal data…", "consumes": [] },
    "copy:estimate.foot": { "kind": "copy", "content": "Estimate, not reported.", "consumes": [] },

    "error:data.view": { "kind": "error", "problem": "The medal data could not be loaded, so this view cannot follow the filter.", "recovery": "Check the connection and reload the page.", "consumes": [] },
    "error:data.dashboard": { "kind": "error", "problem": "The medal data could not be loaded, so the dashboard cannot draw.", "recovery": "Check the connection and reload the page.", "consumes": [] },
    "error:data.filters": { "kind": "error", "problem": "The medal data could not be loaded, so the filter options are unavailable.", "recovery": "Reload the page to try again.", "consumes": [] },
    "error:estimate.explain": { "kind": "error", "problem": "The explanation could not be loaded.", "recovery": "Reload the page to try again.", "consumes": [] },

