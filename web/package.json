{
  "name": "gabf-analysis-web",
  "version": "0.1.0",
  "private": true,
  "description": "The Next.js rebuild of the GABF Analysis site, starting with the design system and its style guide.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "node ../scripts/design-system/build.mjs",
    "check": "node ../scripts/design-system/check.mjs",
    "predev": "npm run tokens",
    "dev": "next dev",
    "prebuild": "npm run tokens && npm run check",
    "build": "next build",
    "serve": "node scripts/serve-out.mjs"
  },
  "dependencies": {
    "echarts": "5.6.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
