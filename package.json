{
  "name": "gabf-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "Great American Beer Festival results explorer: ingest official winners lists, enrich breweries, publish a static analysis site to GitHub Pages.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "node scripts/fetch-winners.mjs",
    "parse": "node scripts/parse-winners.mjs",
    "import-csv": "node scripts/import-results-csv.mjs",
    "styles": "node scripts/import-style-guidelines.mjs",
    "enrich": "node scripts/enrich-breweries.mjs",
    "scrape": "node scripts/scrape-brewery-sites.mjs",
    "build": "node scripts/brand/build.mjs && node scripts/build-site.mjs",
    "winner-db": "node scripts/build-winner-db.mjs 2026",
    "generate": "node scripts/brand/build.mjs && npm run winner-db && node scripts/build-chart-gallery.mjs && node scripts/build-standalone.mjs",
    "new-year": "node scripts/new-year.mjs",
    "render-visuals": "node scripts/render-visuals.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "pretest": "npm run generate",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check-prose.mjs",
    "validate": "node scripts/validate-data.mjs",
    "hops:check": "node scripts/validate-hops.mjs",
    "hops:build": "node scripts/ingest-nass-hops.mjs && node scripts/build-hop-data.mjs && npm run docs:build",
    "docs:build": "node scripts/build-hop-docs.mjs && node scripts/build-brewery-docs.mjs",
    "docs:check": "node scripts/build-hop-docs.mjs --check && node scripts/build-brewery-docs.mjs --check",
    "docs:backlinks": "node scripts/winner-profile-backlinks.mjs",
    "verify": "npm run docs:check && npm run check && npm run brand:check && npm test && npm run validate && npm run hops:check && npm run build && npm run design:check && npm run design-system:check",
    "site:assemble": "node scripts/assemble-site.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "site:dns": "node scripts/site-dns-check.mjs",
    "design-system:build": "node scripts/design-system/build.mjs",
    "design-system:check": "node scripts/design-system/check.mjs",
    "design-system:images": "node scripts/design-system/spec-images.mjs",
    "design-system:audit": "node scripts/design-system/audit-rendered.mjs",
    "design-system:review": "DESIGN_REVIEW=1 npm run build --prefix web && node web/scripts/serve-out.mjs --review",
    "web:install": "npm ci --prefix web",
    "web:build": "npm run build --prefix web",
    "web:serve": "npm run serve --prefix web",
    "web:review": "WEB_REVIEW=1 DESIGN_REVIEW=1 npm run build --prefix web && node web/scripts/review-server.mjs",
    "build:standalone": "node scripts/brand/build.mjs && node scripts/build-standalone.mjs",
    "brand": "node scripts/brand/build.mjs",
    "brand:check": "node scripts/brand/build.mjs --check",
    "brand:social": "node scripts/brand/social-card.mjs",
    "gallery:build": "node scripts/brand/build.mjs && node scripts/build-chart-gallery.mjs",
    "review:build": "GABF_FEEDBACK=1 GABF_DIST=dist-review node scripts/build-site.mjs",
    "review": "WEB_REVIEW=1 DESIGN_REVIEW=1 npm run build --prefix web && npm run design:build && node web/scripts/review-server.mjs --port 4173 --pipeline on",
    "review:serve": "node web/scripts/review-server.mjs --port 4173 --pipeline on",
    "tickets": "node scripts/review-tickets.mjs",
    "decisions": "node scripts/decisions.mjs",
    "design:build": "node scripts/design-control-plane.mjs generate",
    "design:check": "node scripts/design-control-plane.mjs check",
    "design:serve": "node scripts/review-server.mjs"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0",
    "echarts": "6.1.0",
    "marked": "15.0.12",
    "unpdf": "1.8.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1"
  }
}
