{
  "name": "gabf-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "Great American Beer Festival results explorer: ingest official winners lists, enrich breweries, publish a static analysis site to GitHub Pages.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "node scripts/fetch-winners.mjs",
    "parse": "node scripts/parse-winners.mjs",
    "import-csv": "node scripts/import-results-csv.mjs",
    "styles": "node scripts/import-style-guidelines.mjs",
    "enrich": "node scripts/enrich-breweries.mjs",
    "build": "node scripts/build-site.mjs",
    "new-year": "node scripts/new-year.mjs",
    "render-visuals": "node scripts/render-visuals.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "test": "node --test",
    "check": "node scripts/check-prose.mjs",
    "validate": "node scripts/validate-data.mjs",
    "verify": "npm run check && npm test && npm run validate && npm run build && npm run build:standalone && npm run design:check",
    "build:standalone": "node scripts/build-standalone.mjs",
    "review:build": "GABF_FEEDBACK=1 GABF_DIST=dist-review node scripts/build-site.mjs",
    "review": "npm run review:build && node scripts/review-server.mjs",
    "review:serve": "node scripts/review-server.mjs",
    "tickets": "node scripts/review-tickets.mjs",
    "design:build": "node scripts/design-control-plane.mjs generate",
    "design:check": "node scripts/design-control-plane.mjs check",
    "design:serve": "node scripts/review-server.mjs"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "marked": "15.0.12",
    "unpdf": "1.8.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1"
  }
}
