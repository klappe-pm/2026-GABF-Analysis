{
  "$description": "Primitive values for the GABF Analysis design system. Components never use these directly; they use the semantic theme tokens, which alias them.",
  "color": {
    "$type": "color",
    "paper": {
      "white": { "$value": "#FFFFFF", "$description": "Form stock." },
      "chalk": { "$value": "#E8E6DF", "$description": "Chalk ink on graphite stock." }
    },
    "graphite": {
      "50": { "$value": "#F2F3F1" },
      "100": { "$value": "#E4E6E5" },
      "200": { "$value": "#CDD1D2" },
      "300": { "$value": "#AEB3B6" },
      "400": { "$value": "#8A9095" },
      "500": { "$value": "#666C72" },
      "600": { "$value": "#50565C" },
      "700": { "$value": "#3A3F44" },
      "800": { "$value": "#2B2F33" },
      "850": { "$value": "#23272B" },
      "900": { "$value": "#1C1F22" },
      "950": { "$value": "#16181A" }
    },
    "chalk": {
      "200": { "$value": "#B6B4AC" },
      "300": { "$value": "#9C9A92" }
    },
    "green": {
      "100": { "$value": "#E3F0E7" },
      "200": { "$value": "#B5DCC3" },
      "300": { "$value": "#8CC7A3" },
      "600": { "$value": "#2E7650" },
      "700": { "$value": "#22603F" },
      "800": { "$value": "#1A4D33" },
      "950": { "$value": "#1C2B23" }
    },
    "red": {
      "100": { "$value": "#FBE7E3" },
      "300": { "$value": "#F2907F" },
      "600": { "$value": "#B42A21" },
      "950": { "$value": "#36211F" }
    },
    "metal": {
      "gold": { "$value": "#C9A13B", "$description": "Flat gold for medal marks in light theme." },
      "gold-bright": { "$value": "#D9B54E", "$description": "Flat gold for medal marks in dark theme." },
      "silver": { "$value": "#B4B9BD", "$description": "Flat silver, a neutral metal gray." },
      "silver-bright": { "$value": "#C3C7CA" },
      "bronze": { "$value": "#BF7B4A", "$description": "Flat bronze." },
      "bronze-bright": { "$value": "#CC8A58" }
    },
    "ink": {
      "iron-gall": { "$value": "#5B4A66", "$description": "Iron gall ink, a violet black." },
      "iron-gall-light": { "$value": "#B9A6C4" },
      "sepia": { "$value": "#87643A", "$description": "Sepia ink." },
      "sepia-light": { "$value": "#D2AF7F" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Public Sans", "Arial", "sans-serif"],
        "$description": "Interface, headings, body, and figures.",
        "$extensions": { "gabf.cssVar": "--font-public-sans" }
      },
      "narrow": {
        "$value": ["Archivo Narrow", "Arial Narrow", "sans-serif"],
        "$description": "Field labels, table headers, stamps, and dense figure columns.",
        "$extensions": { "gabf.cssVar": "--font-archivo-narrow" }
      }
    },
    "size": {
      "$type": "dimension",
      "micro": { "$value": "0.75rem" },
      "label": { "$value": "0.8125rem" },
      "data": { "$value": "0.875rem" },
      "body": { "$value": "1rem" },
      "lead": { "$value": "1.125rem" },
      "h3": { "$value": "1.25rem" },
      "h2": { "$value": "1.5rem" },
      "h1": { "$value": "2rem" },
      "figure": { "$value": "2.5rem", "$description": "A single large figure inside a form field." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.15 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.6 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "-0.01em" },
      "normal": { "$value": "0em" },
      "label": { "$value": "0.06em", "$description": "Uppercase condensed labels." }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": "0rem" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4rem" }
  },
  "rule": {
    "$type": "dimension",
    "hairline": { "$value": "1px", "$description": "Every structural rule: table cells, field boxes, section rules." },
    "heavy": { "$value": "2px", "$description": "The rule under a form header and over a table header." }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px", "$description": "The only radius. Every corner is square." }
  },
  "duration": {
    "$type": "duration",
    "quick": { "$value": "150ms" },
    "base": { "$value": "200ms" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "40rem" },
    "md": { "$value": "48rem" },
    "lg": { "$value": "64rem" },
    "xl": { "$value": "80rem" }
  },
  "size": {
    "$type": "dimension",
    "measure": { "$value": "40rem", "$description": "Prose measure, about 70 characters." },
    "sheet": { "$value": "40rem", "$description": "Width of the Filters sheet on wide screens." },
    "page": { "$value": "80rem" },
    "table": { "$value": "28rem", "$description": "Height of a ruled table's scroll box, so its header can stick." },
    "chart": { "$value": "18rem", "$description": "Height of a chart frame's plot area." }
  },
  "layer": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 10 },
    "header": { "$value": 20 }
  }
}
